# T2-HQ settings. Copy to .env in the deployed app directory and fill in. Never commit .env.

# Telegram: the bot's token from @BotFather, and the one chat it answers.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Model: google (Gemini free tier) or ollama (a local model)
#MODEL_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
#GEMINI_MODEL=gemini-3.7-flash
#GEMINI_MIN_INTERVAL_SECONDS=7
#OLLAMA_MODEL=qwen3:4b
#OLLAMA_BASE_URL=http://localhost:11434/v1
# Fall back to Ollama when Gemini fails or is rate limited
#OLLAMA_FALLBACK=false

# Where the deployed droids are (default: next to this app) and this app's state
#APPS_DIR=..
#STATE_DIR=var
#WATCH_SECONDS=60
#DRY_RUN_TIMEOUT_SECONDS=900
#LOG_LEVEL=INFO
